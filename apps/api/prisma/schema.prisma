generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserType {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  DRAFT
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  passwordHash String?
  firstName   String?
  lastName    String?
  type        UserType    @default(CUSTOMER)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  roles       UserRole[]
  auditLogs   AuditLog[]
  carts       Cart[]
  orders      Order[]
}

model Role {
  id          String      @id @default(cuid())
  key         String      @unique
  name        String
  createdAt   DateTime    @default(now())
  users       UserRole[]
}

model UserRole {
  userId      String
  roleId      String
  assignedAt  DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  payloadJson Json?
  createdAt   DateTime    @default(now())
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
}

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  products    Product[]
}

model Collection {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  season      String?
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  products    Product[]
}

model Product {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String?
  status        String           @default("draft")
  basePrice     Int
  currency      String           @default("USD")
  categoryId    String?
  collectionId  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collection    Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  variants      ProductVariant[]
  assets        Asset[]
  orderItems    OrderItem[]
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  sku         String      @unique
  size        String?
  color       String?
  stock       Int         @default(0)
  price       Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Asset {
  id          String      @id @default(cuid())
  productId   String?
  url         String
  alt         String?
  kind        String      @default("image")
  createdAt   DateTime    @default(now())
  product     Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Page {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  status      String        @default("draft")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  sections    PageSection[]
}

model PageSection {
  id          String      @id @default(cuid())
  pageId      String
  type        String
  heading     String?
  body        String?
  sortOrder   Int         @default(0)
  page        Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Setting {
  id          String      @id @default(cuid())
  key         String      @unique
  valueJson   Json
  updatedAt   DateTime    @updatedAt
}

model Cart {
  id          String      @id @default(cuid())
  userId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id          String       @id @default(cuid())
  userId      String
  status      OrderStatus  @default(DRAFT)
  currency    String       @default("USD")
  subtotal    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       OrderItem[]
}

model OrderItem {
  id          String      @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int         @default(1)
  unitPrice   Int
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
}
