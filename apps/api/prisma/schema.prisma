generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

model SiteContent {
  id         String   @id @default(cuid())
  locale     String   @unique
  hero       Json
  home       Json
  sections   Json
  spotlights Json
  seo        Json
  media      Json
  house      Json
  contact    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id            String        @id @default(cuid())
  slug          String        @unique
  titleRu       String
  titleEn       String
  collectionRu  String
  collectionEn  String
  price         String
  badgeRu       String
  badgeEn       String
  subtitleRu    String
  subtitleEn    String
  descriptionRu String
  descriptionEn String
  coverImage    String?
  gallery       Json?
  status        ProductStatus @default(DRAFT)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
